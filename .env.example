# Database
DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public"

# Supabase (Optional/Legacy)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Authentication
JWT_SECRET="your-super-secret-jwt-key"

# Email Configuration (SMTP via Brevo - https://app.brevo.com)
# Sign up free at Brevo for 300 emails/day - no port conflicts
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your_brevo_login@email.com"
SMTP_PASSWORD="your_brevo_smtp_key"
SMTP_FROM_NAME="iProduct Repair"
SMTP_FROM_EMAIL="noreply@iproductrepair.in"

# Admin Setup
SUPERADMIN_EMAIL="admin@iproductrepair.in"
SUPERADMIN_PASSWORD="change-me-immediately"

# Other
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="production"
